# 複製成 .env.local 後填入。這個檔案不含任何真實金鑰。

# 盲選卡片代碼的加密金鑰，正式環境必填。產生方式：openssl rand -hex 32
CARD_SECRET=

# 後台登入密碼
ADMIN_PASSWORD=

# Gemini：沒填時自動改用關鍵字比對
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 每月分類呼叫上限，超過後自動降級。預算換算方式見 docs/SPEC.md
GEMINI_MONTHLY_CALL_CAP=150000

# Supabase：沒填時資料只存在記憶體（重啟就清空），僅供本機開發
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 來源模式，建置前設定（首頁與對照表是建置時產生的）：
#   extended（預設）：候選人沒有可查證的官方政見時，採用新聞報導並標示「新聞報導」
#   strict：只用選舉公報、候選人官方來源、公辦政見會；靠新聞報導才完整的縣市不開放
SOURCE_MODE=extended

# 設為 1 時在正式環境也顯示虛構的「示範市」
SHOW_DEMO=
# 預覽之後的模式用，例如 2026-11-28T09:00:00+08:00
PHASE_NOW=
